# ============================================================
# Astro Bridge - central configuration (test mode without WireGuard)
# ============================================================

# --- Celestron Origin (eth0 -> Switch -> Origin) ------------
ORIGIN_NETWORK_CLASS_C='10.10.0'
ORIGIN_IP=10.10.0.10
ORIGIN_MAC_LAN=d8:3a:dd:9b:e7:26

# --- Hotspot (wlan0): ONLY for the guest Wi-Fi web page -----
HOTSPOT_IFACE=wlan0
HOTSPOT_WIFI_SSID='Astrobridge'
HOTSPOT_WIFI_PASSWORD='CHANGEME'

## --- Uplink (wlan1): connects to the guest network ---------
GUEST_WIFI_IFACE=wlan1
GUEST_WIFI_HOST=0.0.0.0
GUEST_WIFI_PORT=80
