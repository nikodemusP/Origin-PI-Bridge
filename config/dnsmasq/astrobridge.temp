# Listen only on these interfaces
interface=br0
interface=lo
# Make sure dnsmasq does not bind to other interfaces
bind-interfaces

# DHCP range for the bridge network (example for @ORIGIN_NETWORK_CLASS_C@.x)
# Hands out IPs from .50 to .100 with a lease time of 12 hours
dhcp-range= @ORIGIN_NETWORK_CLASS_C@.50, @ORIGIN_NETWORK_CLASS_C@.100,255.255.255.0,12h

# Set the default gateway (router) for the clients
# This is the IP of your bridge, since it forwards internet traffic to wlan1
dhcp-option=option:router, @ORIGIN_NETWORK_CLASS_C@.1

# Set the DNS server for the clients
dhcp-option=option:dns-server,8.8.8.8,1.1.1.1

# Optional: always assign the same IP to the Celestron telescope (static lease)
# Replace the MAC address with that of your telescope (see 'ip a' or 'arp')
dhcp-host=@ORIGIN_MAC_LAN@,celestron-origin, @ORIGIN_IP@,infinite

server=1.1.1.1
server=8.8.8.8
